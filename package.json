{
  "name": "dmx-hue",
  "version": "4.0.0-beta.1",
  "description": "Reliable Art-Net to Hue v2 bridge with optional Entertainment streaming",
  "type": "module",
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/patrickmac110/dmx-hue.git"
  },
  "exports": "./index.js",
  "bin": {
    "dmx-hue": "./bin/dmx-hue.js"
  },
  "scripts": {
    "start": "node ./bin/dmx-hue.js",
    "test": "node --test",
    "format": "prettier --write index.js lib bin test docs README.md package.json deploy/*.service .github/workflows/test.yml --ignore-unknown",
    "format:check": "prettier --check index.js lib bin test docs README.md package.json .github/workflows/test.yml"
  },
  "keywords": [
    "philips",
    "hue",
    "dmx",
    "artnet",
    "art-net",
    "universe",
    "node",
    "cli",
    "light",
    "show",
    "bridge"
  ],
  "author": {
    "name": "Yohan Lasorsa",
    "url": "https://twitter.com/sinedied"
  },
  "license": "MIT",
  "homepage": "https://github.com/patrickmac110/dmx-hue",
  "bugs": {
    "url": "https://github.com/patrickmac110/dmx-hue/issues"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "conf": "^12.0.0",
    "inquirer": "^9.1.4",
    "minimist": "^1.2.8",
    "node-dtls-client": "^2.0.3"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "trailingComma": "none",
    "bracketSpacing": true
  },
  "files": [
    "bin",
    "lib",
    "index.js",
    "docs",
    "deploy"
  ]
}
